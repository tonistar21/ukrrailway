generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  TEACHER
  VICE_ADMIN
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum RegistrationType {
  STUDENT
  TEACHER
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

enum ChatStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  DISCONNECTED
}

enum StudentCity {
  KYIV
  LVIV
  DNIPRO
  RIVNE
  ZAPORIZHZHIA
  KHARKIV
}

enum StudentApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MailTargetType {
  TEACHER
  ADMIN
  VICE_ADMIN
}

model User {
  id                           String                 @id @default(cuid())
  telegramUserId               BigInt                 @unique
  username                     String?
  firstName                    String
  lastName                     String?
  fullName                     String
  role                         UserRole               @default(USER)
  status                       UserStatus             @default(ACTIVE)
  registrationType             RegistrationType?
  verificationStatus           VerificationStatus     @default(NOT_STARTED)
  verificationRequestedAt      DateTime?
  verificationReviewedAt       DateTime?
  verificationReviewedByUserId String?
  profileName                  String?
  profilePhone                 String?
  profileTelegramTag           String?
  teacherCity                  StudentCity?
  teacherClub                  String?
  studentFullName              String?
  studentAge                   Int?
  studentCity                  StudentCity?
  studentClub                  String?
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt

  createdChats                 Chat[]                 @relation("ChatCreator")
  createdEvents                Event[]                @relation("EventCreator")
  assignedApplications         StudentApplication[]   @relation("AssignedTeacherApplications")
  reviewedApplications         StudentApplication[]   @relation("ReviewedApplications")
  ownApplications              StudentApplication[]   @relation("ApplicantApplications")
  sentMailTickets              MailTicket[]           @relation("MailTicketSender")
  receivedMailTickets          MailTicketRecipient[]  @relation("MailTicketRecipientUser")
  newsFireStreak               NewsFireStreak?
  newsFireClicks               NewsFireClick[]
  verificationReviewedBy       User?                  @relation("UserVerificationReviews", fields: [verificationReviewedByUserId], references: [id], onDelete: SetNull)
  reviewedVerificationUsers    User[]                 @relation("UserVerificationReviews")

  @@index([registrationType, verificationStatus])
  @@index([verificationReviewedByUserId])
}

model Chat {
  id              String      @id @default(cuid())
  telegramChatId  BigInt?     @unique
  title           String
  status          ChatStatus  @default(DRAFT)
  createdByUserId String
  club            String
  ageGroup        String
  contactInfo     String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  createdBy       User        @relation("ChatCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  applications    StudentApplication[]
  participants    ChatParticipant[]
  eventDeliveries EventDelivery[]
  attendanceSessions AttendanceSession[]
  gradeSessions   GradeSession[]
}

model ChatParticipant {
  id             String   @id @default(cuid())
  chatId         String
  telegramUserId BigInt
  username       String?
  firstName      String
  lastName       String?
  fullName       String
  isBot          Boolean  @default(false)
  isInChat       Boolean  @default(true)
  lastSeenAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  chat           Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, telegramUserId])
  @@index([chatId, isInChat, fullName])
}

model StudentApplication {
  id                    String                    @id @default(cuid())
  applicantUserId       String
  fullName              String
  age                   Int
  city                  StudentCity
  club                  String
  status                StudentApplicationStatus  @default(PENDING)
  assignedTeacherUserId String
  targetChatId          String
  reviewedByUserId      String?
  reviewedAt            DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  applicant             User                      @relation("ApplicantApplications", fields: [applicantUserId], references: [id], onDelete: Cascade)
  assignedTeacher       User                      @relation("AssignedTeacherApplications", fields: [assignedTeacherUserId], references: [id], onDelete: Cascade)
  reviewedBy            User?                     @relation("ReviewedApplications", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  targetChat            Chat                      @relation(fields: [targetChatId], references: [id], onDelete: Cascade)

  @@index([assignedTeacherUserId, status])
  @@index([applicantUserId, status])
}

model Event {
  id              String          @id @default(cuid())
  createdByUserId String
  title           String
  text            String
  photoFileId     String?
  scheduledFor    DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  createdBy       User            @relation("EventCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  deliveries      EventDelivery[]

  @@index([createdByUserId, scheduledFor])
}

model EventDelivery {
  id                   String    @id @default(cuid())
  eventId              String
  chatId               String
  messageId            Int
  sentAt               DateTime  @default(now())
  pinnedAt             DateTime?
  reminderDaySentAt    DateTime?
  reminderHourSentAt   DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  event                Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  chat                 Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([eventId, chatId])
  @@index([chatId, sentAt])
  @@index([reminderDaySentAt, reminderHourSentAt])
}

model AttendanceSession {
  id          String             @id @default(cuid())
  chatId       String
  sessionDate  DateTime
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  chat         Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  records      AttendanceRecord[]

  @@unique([chatId, sessionDate])
  @@index([chatId, sessionDate])
}

model AttendanceRecord {
  id                  String            @id @default(cuid())
  attendanceSessionId String
  telegramUserId      BigInt
  isPresent           Boolean           @default(false)
  markedAt            DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)

  @@unique([attendanceSessionId, telegramUserId])
  @@index([attendanceSessionId, isPresent])
}

model GradeSession {
  id          String        @id @default(cuid())
  chatId      String
  sessionDate DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  chat        Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  records     GradeRecord[]

  @@unique([chatId, sessionDate])
  @@index([chatId, sessionDate])
}

model GradeRecord {
  id             String       @id @default(cuid())
  gradeSessionId String
  telegramUserId BigInt
  grade          Int?
  markedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  gradeSession   GradeSession @relation(fields: [gradeSessionId], references: [id], onDelete: Cascade)

  @@unique([gradeSessionId, telegramUserId])
  @@index([gradeSessionId, grade])
}

model NewsItem {
  id               String            @id @default(cuid())
  source           String
  externalId       String
  title            String
  dateText         String?
  location         String?
  description      String
  imageUrl         String?
  localImagePath   String?
  indexInSource    Int
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  viewSessions     NewsViewSession[]

  @@unique([source, externalId])
  @@index([source, isActive, indexInSource])
}

model NewsViewSession {
  id                String    @id @default(cuid())
  telegramUserId    BigInt    @unique
  chatId            BigInt
  messageId         Int
  source            String    @default("interesting_events")
  currentNewsItemId String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  currentNewsItem   NewsItem  @relation(fields: [currentNewsItemId], references: [id], onDelete: Cascade)

  @@index([source, updatedAt])
}

model NewsFireStreak {
  id                 String    @id @default(cuid())
  userId             String    @unique
  currentStreak      Int       @default(0)
  longestStreak      Int       @default(0)
  totalFires         Int       @default(0)
  lastClickedDateKey String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastClickedDateKey, currentStreak])
  @@index([currentStreak, longestStreak])
}

model NewsFireClick {
  id        String    @id @default(cuid())
  userId    String
  dateKey   String
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([dateKey])
}

model MailTicket {
  id          String                @id @default(cuid())
  senderUserId String
  targetType  MailTargetType
  text        String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  sender      User                  @relation("MailTicketSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  recipients  MailTicketRecipient[]

  @@index([senderUserId, createdAt])
  @@index([targetType, createdAt])
}

model MailTicketRecipient {
  id              String     @id @default(cuid())
  ticketId        String
  recipientUserId String
  isRead          Boolean    @default(false)
  readAt          DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  ticket          MailTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  recipient       User       @relation("MailTicketRecipientUser", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([ticketId, recipientUserId])
  @@index([recipientUserId, isRead, createdAt])
}
